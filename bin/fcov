#!/usr/bin/env bash
# bin/fcov — launcher for the fcov coverage tool.
#
# Wraps gforth with:
#   - fcov repo root on fpath  (so `require fcov/...` resolves regardless of cwd)
#   - tty-safe terminal reset  (no escape leakage when stdout is piped)
#   - CWD-aware env vars       (FCOV_HOME, FCOV_CMD, FCOV_ARG, FCOV_REST)
#
# Suggested ~/.bashrc snippet — one PATH line per tool so each can be
# moved or removed independently:
#
#     export FCOV_HOME="$HOME/fcov"
#     export PATH="$FCOV_HOME/bin:$PATH"
#
# (Mirror the same pattern for fmix and flint — each tool with its own
# HOME var + PATH line.)

set -e

FCOV_HOME="${FCOV_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
export FCOV_HOME

# Capture the *real* gforth path now, before `fcov run` rewrites PATH to
# put .fcov/bin/ on top (which contains a thin gforth shim that re-execs
# the real gforth with the instrumentation prelude pre-loaded).
export FCOV_REAL_GFORTH="${FCOV_REAL_GFORTH:-$(command -v gforth || true)}"

# --- CLI parse ----------------------------------------------------------

FCOV_RUN_STRICT=0
FCOV_FAIL_UNDER=""

cmd="${1:-help}"
shift || true

arg=""
rest=""

case "$cmd" in
    run)
        while [ $# -gt 0 ]; do
            case "$1" in
                --strict) FCOV_RUN_STRICT=1; shift ;;
                --) shift; break ;;
                --*)
                    echo "[ERROR] Unknown run flag: $1" >&2
                    exit 1
                    ;;
                *) break ;;
            esac
        done
        if [ $# -gt 0 ]; then
            arg=$1
            shift
            rest="$*"
        fi
        ;;
    report)
        while [ $# -gt 0 ]; do
            case "$1" in
                --fail-under)
                    shift
                    [ $# -gt 0 ] || { echo "[ERROR] --fail-under requires a number" >&2; exit 1; }
                    FCOV_FAIL_UNDER=$1
                    shift
                    ;;
                --fail-under=*)
                    FCOV_FAIL_UNDER=${1#--fail-under=}
                    shift
                    ;;
                --format)
                    shift
                    [ $# -gt 0 ] || { echo "[ERROR] --format requires a value" >&2; exit 1; }
                    arg=--format
                    rest=$1
                    shift
                    ;;
                --format=*)
                    arg=--format
                    rest=${1#--format=}
                    shift
                    ;;
                --) shift; break ;;
                --*)
                    echo "[ERROR] Unknown report flag: $1" >&2
                    exit 1
                    ;;
                *) break ;;
            esac
        done
        ;;
    *)
        arg="${1:-}"
        if [ -n "$arg" ]; then
            shift
            rest="$*"
        fi
        ;;
esac

export FCOV_CMD="$cmd"
export FCOV_ARG="$arg"
export FCOV_REST="$rest"
export FCOV_CWD="$PWD"
export FCOV_RUN_STRICT
export FCOV_FAIL_UNDER

# --- TTY hygiene --------------------------------------------------------
# Gforth's bracketed-paste mode leaks a `^[[?2004l` reset when it exits.
# Only emit our own reset if stdout *is* a tty — otherwise it ends up
# inside `out=$(fcov ...)` as literal garbage.
reset_tty() {
    if [ -t 1 ]; then
        printf '\033[?2004l' >&2
    fi
}
trap reset_tty EXIT

# --- gforth invocation --------------------------------------------------

exec gforth \
    -e "s\" $FCOV_HOME\" fpath also-path" \
    "$FCOV_HOME/fcov.4th"
